# CHRONOVISOR — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# LLM Provider: cerebras | openrouter | groq | gemini
LLM_PROVIDER=cerebras

# Cerebras API Key (get from https://cloud.cerebras.ai)
CEREBRAS_API_KEY=your-cerebras-api-key-here

# — OR — OpenRouter (access 100+ models)
# OPENROUTER_API_KEY=your-openrouter-key-here
# OPENROUTER_MODEL=google/gemini-2.5-flash

# — OR — Groq (fast inference)
# GROQ_API_KEY=your-groq-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# — OR — Google Gemini (original)
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Google Earth Engine project ID (optional, for real satellite data)
GEE_PROJECT_ID=chronovisor-498714

# API settings
CHRONOVISOR_HOST=0.0.0.0
CHRONOVISOR_PORT=8500

# Cache TTL in seconds (default 1 hour)
CACHE_TTL=3600
