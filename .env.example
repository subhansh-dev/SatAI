# SatAI — SatQuery AI · Environment Variables (PS SIH26167)
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---------------------------------------------------------------------------
# VLM backend — cloud (development) or local vLLM (ISRO finals / air-gapped)
# ---------------------------------------------------------------------------
VLM_MODE=cloud                   # cloud | local

# Cloud: OpenRouter (or any OpenAI-compatible vision endpoint)
OPENROUTER_API_KEY=your-openrouter-key-here
CLOUD_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL=qwen/qwen-2.5-vl-72b-instruct

# Local: vLLM OpenAI-compatible server (see vllm_config.yaml)
# VLM_MODE=local
# VLM_LOCAL_URL=http://localhost:8000/v1
# VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# VLM_LORA_ADAPTER=satai-rs      # RS-adapted LoRA registered via --lora-modules

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
SATAI_HOST=0.0.0.0
SATAI_PORT=8500
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SEC=60

# ---------------------------------------------------------------------------
# Inference tuning (optional)
# ---------------------------------------------------------------------------
# VLM_MAX_SIDE=1344              # VLM view downscale (px, Qwen2.5-VL budget)
# VLM_MAX_TOKENS=1024
# VLM_TEMPERATURE=0.1
# VLM_TIMEOUT_SEC=180

# ---------------------------------------------------------------------------
# Change-map heuristics (optional)
# ---------------------------------------------------------------------------
# CHANGE_DIFF_K=2.5              # threshold = mean + k*std of the diff image
# CHANGE_MIN_REGION_PCT=0.05
